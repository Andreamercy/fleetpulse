# Copy to .env. NEVER commit real secrets; in Kubernetes these come from the cloud secret manager (External Secrets).
ENV=dev
JWT_SECRET=change-me-to-a-32-byte-or-longer-random-string
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fleet:change-me@postgres:5432/fleetpulse
CLICKHOUSE_HOST=clickhouse
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=redpanda:9092
REPO=sql
VEHICLES=100000
