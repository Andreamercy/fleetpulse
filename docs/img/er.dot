digraph ER { rankdir=LR; bgcolor="white"; node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, arrowhead=crow, color="#555555"];
 tenant [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>tenant</b></td></tr><tr><td align="left">PK id<br/>name (UQ)</td></tr></table>>];
 plan [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>plan</b></td></tr><tr><td align="left">PK id<br/>name · max_vehicles · price</td></tr></table>>];
 subscription [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>subscription</b></td></tr><tr><td align="left">PK id<br/>FK tenant_id · FK plan_id<br/>status · valid_from/to</td></tr></table>>];
 app_user [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>app_user</b></td></tr><tr><td align="left">PK id · FK tenant_id<br/>email (UQ)</td></tr></table>>];
 role [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>role / user_role</b></td></tr><tr><td align="left">role(id,name)<br/>user_role(user_id, role_id)</td></tr></table>>];
 fleet [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>fleet</b></td></tr><tr><td align="left">PK id · FK tenant_id<br/>UQ(id, tenant_id)</td></tr></table>>];
 vehicle_model [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>vehicle_model</b></td></tr><tr><td align="left">PK id<br/>oem · model · year · fuel_type</td></tr></table>>];
 vehicle [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#fff0c2"><b>vehicle</b></td></tr><tr><td align="left">PK id · vin (UQ, regex CHECK)<br/>FK model_id<br/>FK (fleet_id, tenant_id) *denorm*<br/>registered_on · status</td></tr></table>>];
 driver [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>driver</b></td></tr><tr><td align="left">PK id · FK tenant_id<br/>pseudonym</td></tr></table>>];
 driver_assignment [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>driver_assignment</b></td></tr><tr><td align="left">PK id · FK driver_id<br/>FK vehicle_id · valid_from/to</td></tr></table>>];
 trip [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>trip</b></td></tr><tr><td align="left">PK id · FK vehicle_id · FK driver_id<br/>started/ended · distance · harsh</td></tr></table>>];
 alert_type [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>alert_type</b></td></tr><tr><td align="left">PK code<br/>default_severity</td></tr></table>>];
 alert [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#fff0c2"><b>alert</b></td></tr><tr><td align="left">PK id · FK vehicle_id<br/>FK tenant_id *denorm*<br/>FK type_code · severity<br/>raised_at · status</td></tr></table>>];
 vehicle_risk [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#fff0c2"><b>vehicle_risk</b></td></tr><tr><td align="left">PK/FK vehicle_id<br/>FK tenant_id *denorm*<br/>score · model_version · factors</td></tr></table>>];
 work_order [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>work_order</b></td></tr><tr><td align="left">PK id (uuid) · FK vehicle_id<br/>FK tenant_id · status<br/>created_by · approved_by</td></tr></table>>];
 fault_case [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#e3f4e1"><b>fault_case (pgvector)</b></td></tr><tr><td align="left">PK id · FK vehicle_id<br/>embedding vector(13) HNSW</td></tr></table>>];
 dtc_catalog [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>dtc_catalog</b></td></tr><tr><td align="left">PK code · system<br/>description · severity</td></tr></table>>];
 audit_log [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#d9e6f7"><b>audit_log</b></td></tr><tr><td align="left">PK id · ts · actor · tenant_id<br/>action · resource · detail<br/>prev_hash · hash</td></tr></table>>];
 tenant -> subscription; plan -> subscription; tenant -> app_user; app_user -> role [label="M:N"]; tenant -> fleet; fleet -> vehicle; vehicle_model -> vehicle; tenant -> driver;
 driver -> driver_assignment; vehicle -> driver_assignment; vehicle -> trip; driver -> trip; vehicle -> alert; alert_type -> alert; vehicle -> vehicle_risk [arrowhead=tee]; vehicle -> work_order; vehicle -> fault_case; tenant -> audit_log [style=dashed]; }
